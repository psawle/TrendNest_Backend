PORT=8000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB must be a replica set (checkout/cancel/delete use multi-document transactions).
# See docker-compose.yml for a local single-node replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/trendnest?replicaSet=rs0

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# S3 bucket for product images. See README for bucket policy / IAM setup.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
